# 服务端口
PORT=3000

# OpenAI 兼容API配置 (用于生成提示词 + 视觉标注)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# 视觉LLM配置 (用于图片标注)
VISION_API_BASE=https://api.openai.com/v1
VISION_API_KEY=sk-your-key-here
VISION_MODEL=gpt-4o

# 生图API配置 (兼容 OpenAI DALL-E / Stable Diffusion API)
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_API_KEY=sk-your-key-here
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1024

# Python路径 (用于YOLO训练)
PYTHON_PATH=python

# 每个任务生成的图片数量
DEFAULT_IMAGE_COUNT=50
# 训练轮数
DEFAULT_EPOCHS=50
# 测试集占比
TEST_SPLIT_RATIO=0.2
