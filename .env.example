# 服务端口
PORT=3015

# ===== 提示词生成 (OpenRouter + Gemini 2.5 Flash) =====
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxx
LLM_MODEL=google/gemini-2.5-flash

# ===== 视觉标注 (OpenRouter + Gemini 3.1 Pro) =====
VISION_API_BASE=https://openrouter.ai/api/v1
VISION_API_KEY=sk-or-v1-xxx
VISION_MODEL=google/gemini-3.1-pro-preview

# ===== 生图 (fal.ai Z-Image Turbo) =====
FAL_API_KEY=your-fal-key-here
FAL_IMAGE_SIZE=square_hd

# ===== Python路径 (用于YOLO训练) =====
PYTHON_PATH=python

# ===== 默认参数 =====
DEFAULT_IMAGE_COUNT=50
DEFAULT_EPOCHS=50
TEST_SPLIT_RATIO=0.2
