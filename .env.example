# 服务端口
PORT=3000

# ===== 提示词生成 (OpenRouter + Gemini 2.5 Flash) =====
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxx
LLM_MODEL=google/gemini-2.5-flash

# ===== 视觉标注 (OpenRouter + Gemini 3.1 Pro) =====
VISION_API_BASE=https://openrouter.ai/api/v1
VISION_API_KEY=sk-or-v1-xxx
VISION_MODEL=google/gemini-3.1-pro-preview

# ===== 生图 (fal.ai Z-Image Turbo) =====
FAL_API_KEY=your-fal-key-here
FAL_IMAGE_SIZE=square_hd

# ===== Python路径 (用于YOLO训练) =====
PYTHON_PATH=python

# ===== YOLO模型配置 =====
# 预训练模型: yolo11n.pt(v11 Nano), yolov8n.pt(v8 Nano), yolo11s.pt(v11 Small) 等
YOLO_MODEL=yolo11n.pt

# ===== 数据增强 =====
# mosaic 增强比例 (0.0~1.0, 默认1.0=全部启用)
AUGMENT_MOSAIC=1.0
# mixup 增强比例 (0.0~1.0, 默认0.3, 原始YOLO默认0.0)
AUGMENT_MIXUP=0.3
# 复制粘贴增强 (0.0~1.0)
AUGMENT_COPY_PASTE=0.1
# 缩放范围
AUGMENT_SCALE=0.9

# ===== 负样本 =====
# 负样本占总图片比例 (0.0~0.5, 如0.15表示15%图片为负样本)
NEGATIVE_SAMPLE_RATIO=0.15

# ===== 默认参数 =====
DEFAULT_IMAGE_COUNT=50
DEFAULT_EPOCHS=50
TEST_SPLIT_RATIO=0.2
