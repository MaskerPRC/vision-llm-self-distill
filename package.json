{
  "name": "yolo-pipeline",
  "version": "1.0.0",
  "description": "自动化YOLO训练流水线 - 从需求到模型的一站式解决方案",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "setup": "npm install && cd client && npm install",
    "train:deps": "pip install ultralytics"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "better-sqlite3": "^11.6.0",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "concurrently": "^9.0.1"
  }
}
